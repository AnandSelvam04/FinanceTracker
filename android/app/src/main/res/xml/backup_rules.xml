<?xml version="1.0" encoding="utf-8"?>
<!--
  Pre-Android 12 counterpart to data_extraction_rules.xml. Redundant while
  android:allowBackup="false" is set, but kept so the intent survives if that
  attribute is ever flipped: nothing about the user's financial data belongs
  in an automatic off-device backup.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
